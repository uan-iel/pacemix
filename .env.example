# Copy this file to .env.local. Never commit .env.local.
# The API key is read only by the local Node proxy and is never exposed to Vite.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Local NLU proxy configuration.
PACEMIX_NLU_PORT=8788
PACEMIX_ALLOWED_ORIGIN=http://127.0.0.1:4173
VITE_PACEMIX_NLU_ENDPOINT=http://127.0.0.1:8788/api/pace-nlu
